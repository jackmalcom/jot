{
  "name": "jot",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "apps/node",
    "apps/web"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "npm run build -w @jot/web",
    "start": "node --env-file-if-exists=.env --import tsx apps/node/src/index.ts",
    "operator": "node --env-file-if-exists=.env --import tsx scripts/operator.ts",
    "check": "svelte-check --workspace apps/web --tsconfig ../../tsconfig.json && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "cloudflare:setup": "npm --prefix apps/cloudflare install",
    "cloudflare:check": "npm run build && npm --prefix apps/cloudflare run check",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
