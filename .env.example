BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:5173
PORT=3000
DATABASE_PATH=./data/jot.sqlite
# Required only for remote operator commands. Use a separate random secret.
# OPERATOR_SECRET=

# Optional private S3-compatible image storage. Set all five values to enable.
# For local Docker S3: docker compose -f compose.s3.yaml up -d
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=jot-images
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=jot-local
# S3_SECRET_ACCESS_KEY=jot-local-secret
# S3_FORCE_PATH_STYLE=true
